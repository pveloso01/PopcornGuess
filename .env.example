# PopcornGuess environment variables. Copy to .env for local dev.
# Production values live in Fly.io secrets and Vercel project settings.

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_DB=popcornguess
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Optional override; defaults composed from the three vars above.
# DATABASE_URL=postgres://user:pass@host:5432/db

# ── Django backend ────────────────────────────────────────────────────
DEBUG=True
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Throttling (optional overrides)
# THROTTLE_ANON=60/min
# THROTTLE_USER=240/min
# THROTTLE_AUTOCOMPLETE=30/min
# THROTTLE_SUBMIT=30/min
# THROTTLE_LOGIN=10/min

# ── Optional integrations ─────────────────────────────────────────────
# TMDb (https://www.themoviedb.org/settings/api) — free, no card required.
TMDB_API_KEY=

# Google AI Studio Gemini (https://aistudio.google.com/) — free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Resend (https://resend.com) — 3 K free emails/month.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=PopcornGuess <noreply@example.com>

# Sentry — leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Service token used by the GitHub Actions content cron to POST puzzles.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
PUZZLE_SEED_TOKEN=

# Deploy metadata (set automatically by CI on Fly).
DEPLOY_ENV=development
RELEASE_SHA=

# ── Social auth (optional) ────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase-1 launches with everything off; turn flags on as features ship.
# Comma-separated: blitz, practice, modes, leaderboard, profile, friends,
# leagues, auth, archive
NEXT_PUBLIC_FEATURE_FLAGS=

# Sentry browser DSN — leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
